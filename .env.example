# Peripheral — copy to .env and fill in. .env is gitignored; this file is the
# contract. Never put a real value in this file.
#
# .env IS NOT OPTIONAL on a machine that runs the daemon unattended. A
# scheduled task inherits nothing from your terminal, so a variable you only
# ever exported by hand does not exist at logon. That is exactly how the first
# run of the logon task died: PLAYWRIGHT_BROWSERS_PATH was unset and Chromium
# was not where Playwright looked. (2026-08-17)

# ── server ────────────────────────────────────────────────────────────────
# 4780 = 1280 wide, 480 tall. Binds 127.0.0.1 only.
PERIPHERAL_PORT=4780

# ── Google Calendar (read-only) ───────────────────────────────────────────
# Desktop-app OAuth client from console.cloud.google.com.
# Scope requested: https://www.googleapis.com/auth/calendar.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Accounts to authorise. As of 2026-08-17 this is ONE account: work.
# Personal is natively shared INTO the work calendar, so a single token gets
# both halves and Google does the merge server-side. Do not add `personal`
# here unless the work share breaks.
#   Work account: ricky.cadden@balcomagency.com
PERIPHERAL_ACCOUNTS=work

# Where the last-good agenda is cached, so a restart doesn't start blank.
# Default (leave blank): %LOCALAPPDATA%\Peripheral\last-state.json
# Outside the repo for the same reason as the token store: it holds real event
# titles from a work calendar, and this repo goes public.
PERIPHERAL_STATE_PATH=

# Where the refresh token lives. Default (leave blank):
#   %LOCALAPPDATA%\Peripheral\tokens.json
# DELIBERATELY OUTSIDE THIS REPO. A long-lived refresh token has no business in
# a project directory — it survives a `git clean`, it gets caught by an
# over-broad `git add -f`, and it would follow the repo into any synced or
# shared folder. Only set this if you have somewhere better.
PERIPHERAL_TOKEN_PATH=

# Calendar IDs to include, per account. Empty = all calendars on that account,
# discovered once per process and labelled by guessLabel() in src/sources/gcal.js.
# Format is comma-separated `id=label` pairs; a bare id takes the account name:
#   PERIPHERAL_CALENDARS_WORK=ricky@balcomagency.com=work,grcadden@gmail.com=personal
# Run `npm run auth` — it prints every visible calendar with its real id and a
# paste-ready map. Shared-in and imported calendars use opaque ids; never guess.
# Confirmed on the personal account as of 2026-08-17:
#   grcadden@gmail.com
#   en.usa#holiday@group.v.calendar.google.com
#   kcbn7gua52qb1enmissvieovipboc050@import.calendar.google.com  (VB JV Women)
#   j5k7hdkp4mt4ijqeqdl4cmlvfvd60e62@import.calendar.google.com  (VB MS Girls)
PERIPHERAL_CALENDARS_WORK=

# ── palette ───────────────────────────────────────────────────────────────
# PERIPHERAL_HERO_HUE / PERIPHERAL_COOL_HUE / PERIPHERAL_CALENDAR_WORK_HUE /
# PERIPHERAL_CALENDAR_PERSONAL_HUE — per-run experiments, read by
# src/palette.js at CLI time (`npm run palette`). Leave unset to use the
# committed defaults (or whatever's saved via the colour picker at
# /settings/palette/). An env var here ALWAYS wins over a picker-saved
# choice — that's the point of it being the more explicit, temporary
# override. See src/palette.js's HUE POLICY comment for the full reasoning.
#
# The picker's own saved choices live outside this file, at
# %LOCALAPPDATA%\Peripheral\palette-overrides.json — override that path with
# PERIPHERAL_PALETTE_OVERRIDES_PATH, same convention as PERIPHERAL_TOKEN_PATH.

# ── weather location ─────────────────────────────────────────────────────
# This install's default location is hardcoded in src/sources/weather.js
# (see the dated comment there) — nothing here needs setting for that to
# work. A location entered at /settings/palette/ (zip code -> NWS grid,
# both free/keyless) is saved outside this file too, at
# %LOCALAPPDATA%\Peripheral\weather-location.json — override that path with
# PERIPHERAL_WEATHER_LOCATION_PATH, same convention as the other *_PATH vars.

# ── transport ─────────────────────────────────────────────────────────────
# Thermalright Trofeo Vision 6.86". Verify with `npm run probe` before trusting.
PERIPHERAL_HID_VID=0x0416
PERIPHERAL_HID_PID=0x5302
PERIPHERAL_FPS=1
# How the panel is physically mounted. 0 (default) or 180 — nothing else; the
# glass is 1280x480 and a quarter turn would need a different pane, not a
# transform. Applied only to the frame pushed to the panel: the pane URL you
# open in a browser stays upright either way.
#
# This is the DEFAULT, not an override. Orientation is normally set at
# /settings/palette/, and a value saved there WINS over this line — the
# opposite of the palette hue vars above, deliberately: a toggle in a web UI
# that an env var could silently outrank would flip, report success, and
# change nothing. This exists so an unattended install can be oriented before
# anyone opens a browser. The picker says out loud when it is overriding it.
# Saved orientation lives at %LOCALAPPDATA%\Peripheral\display.json —
# override that path with PERIPHERAL_DISPLAY_PATH.
PERIPHERAL_ROTATE=0
# Set true to render frames to ./frames/ instead of pushing to the panel.
PERIPHERAL_DRY_RUN=false

# ── Playwright browser cache ──────────────────────────────────────────────
# The repo now lives at C:\dev\peripheral, outside OneDrive, so this is no
# longer a sync workaround — but a ~120MB browser download still has no business
# inside a project directory. Shared across projects, and survives a clean clone.
PLAYWRIGHT_BROWSERS_PATH=C:\dev\ms-playwright
