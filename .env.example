# Peripheral — copy to .env and fill in. .env is gitignored; this file is the
# contract. Never put a real value in this file.

# ── server ────────────────────────────────────────────────────────────────
# 4780 = 1280 wide, 480 tall. Binds 127.0.0.1 only.
PERIPHERAL_PORT=4780

# ── Google Calendar (read-only) ───────────────────────────────────────────
# Desktop-app OAuth client from console.cloud.google.com.
# Scope requested: https://www.googleapis.com/auth/calendar.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Accounts to authorise. As of 2026-08-17 this is ONE account: work.
# Personal is natively shared INTO the work calendar, so a single token gets
# both halves and Google does the merge server-side. Do not add `personal`
# here unless the work share breaks.
#   Work account: ricky.cadden@balcomagency.com
PERIPHERAL_ACCOUNTS=work

# Where the refresh token lives. Default (leave blank):
#   %LOCALAPPDATA%\Peripheral\tokens.json
# DELIBERATELY OUTSIDE THIS REPO. The repo is inside OneDrive, and a Balcom
# refresh token must not be uploaded to Microsoft. .gitignore stops git, not
# OneDrive. Only set this if you have somewhere better that is also unsynced.
PERIPHERAL_TOKEN_PATH=

# Calendar IDs to include, per account. Empty = all calendars on that account.
# Run `npm run auth` — it prints every visible calendar with its real id and a
# paste-ready map. Shared-in and imported calendars use opaque ids; never guess.
# Confirmed on the personal account as of 2026-08-17:
#   grcadden@gmail.com
#   en.usa#holiday@group.v.calendar.google.com
#   kcbn7gua52qb1enmissvieovipboc050@import.calendar.google.com  (VB JV Women)
#   j5k7hdkp4mt4ijqeqdl4cmlvfvd60e62@import.calendar.google.com  (VB MS Girls)
PERIPHERAL_CALENDARS_WORK=

# ── transport ─────────────────────────────────────────────────────────────
# Thermalright Trofeo Vision 6.86". Verify with `npm run probe` before trusting.
PERIPHERAL_HID_VID=0x0416
PERIPHERAL_HID_PID=0x5302
PERIPHERAL_FPS=1
# Set true to render frames to ./frames/ instead of pushing to the panel.
PERIPHERAL_DRY_RUN=false

# ── OneDrive workaround ───────────────────────────────────────────────────
# This repo lives inside OneDrive, which locks files it is syncing. Keep the
# ~120MB Playwright browser download outside sync scope or expect EBUSY.
PLAYWRIGHT_BROWSERS_PATH=C:\dev\ms-playwright
