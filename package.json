{
  "name": "peripheral",
  "version": "0.1.0",
  "private": true,
  "description": "Your life, in the corner of your eye. An ambient panel for a 1280x480 USB LCD.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcadden/peripheral.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "serve": "node --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/daemon.js",
    "_comment_test": "Scoped glob on purpose. Bare `node --test` auto-discovers anything matching *-test.js, which sweeps in src/transport/idle-test.js and pushes frames to real hardware for 68s. Tests must never drive the panel.",
    "test": "node --test \"test/**/*.test.js\"",
    "auth": "node --env-file-if-exists=.env src/auth/login.js",
    "palette": "node src/palette.js",
    "probe": "node src/transport/probe.js",
    "startup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 -Action install",
    "startup:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 -Action uninstall",
    "startup:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 -Action status",
    "startup:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 -Action logs",
    "watchdog:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 -Action watchdog-logs",
    "_comment_watchdog_test": "Fault injection against the real daemon, same rule as idle-test and stall-test: it runs the actual end/sweep/run recovery path rather than simulating it. The panel WILL blink.",
    "watchdog:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 -Action watchdog-run",
    "send": "node --env-file-if-exists=.env src/transport/send.js",
    "idle-test": "node --env-file-if-exists=.env src/transport/idle-test.js",
    "stall-test": "node src/transport/stall-test.js"
  },
  "optionalDependencies": {
    "node-hid": "^3.4.0",
    "playwright": "^1.62.1",
    "sharp": "^0.33.5"
  }
}
